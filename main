#!/bin/bash
#PBS -l nodes=1:ppn=1,vmem=8g,walltime=2:00:00
#PBS -N app-streamline-cleaning
#PBS -V

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CLEAN_SCRIPT="${SCRIPT_DIR}/scripts/filter_spurious_streamlines.sh"

# ============================================================================
# Read parameters from config.json
# ============================================================================

track=$(jq -r '.track // "null"' config.json)
tcks=$(jq -r '.tcks // "null"' config.json)

min_length=$(jq -r '.min_length // 0' config.json)
max_length=$(jq -r '.max_length // 10000000' config.json)
angle=$(jq -r '.angle // 360' config.json)

reference=$(jq -r '.reference // empty' config.json)
no_qb_loops=$(jq -r '.no_qb_loops // false' config.json)
alpha=$(jq -r '.alpha // empty' config.json)
no_outlier_rejection=$(jq -r '.no_outlier_rejection // false' config.json)
purifibre=$(jq -r '.purifibre // empty' config.json)
purifibre_first=$(jq -r '.purifibre_first // empty' config.json)
loop_qb_thr=$(jq -r '.loop_qb_thr // 8' config.json)
nthreads=$(jq -r '.nthreads // 1' config.json)
structural=$(jq -r '.structural // empty' config.json)
output_dir=$(jq -r '.output_dir // "null"' config.json)

# ============================================================================
# Validate mandatory input and resolve input mode
# ============================================================================

resolved_tcks_dir="null"

if [[ "$track" != "null" && -n "$track" ]]; then
    # --- single-track mode ---
    if [ ! -f "$track" ]; then
        echo "[ERROR] Input track not found: $track" >&2
        exit 1
    fi
elif [[ "$tcks" != "null" && -n "$tcks" ]]; then
    # --- tcks directory mode ---
    if [[ -d "$tcks" ]]; then
        :
    else
        echo "[WARN] tcks is not a directory: $tcks"
        echo "[WARN] checking parent folder instead..."
        tcks="$(dirname "$tcks")"
    fi

    if [[ -d "$tcks/tcks" ]]; then
        tcks="$tcks/tcks"
    fi

    shopt -s nullglob
    tck_files=("$tcks"/*.tck)
    shopt -u nullglob

    if [[ ${#tck_files[@]} -eq 0 ]]; then
        echo "[ERROR] no .tck files found in directory: $tcks" >&2
        exit 1
    fi

    resolved_tcks_dir="$tcks"
else
    echo "[ERROR] Either 'track' or 'tcks' is required in config.json" >&2
    exit 1
fi

# ============================================================================
# Helper: run cleaning on a single tractogram
# ============================================================================

run_one_tract() {
    local tractogram="$1"
    local output_track="$2"
    local cmd

    cmd=( bash "${CLEAN_SCRIPT}" )
    [ -n "$reference" ]                  && cmd+=( --reference "${reference}" )
    [ "$no_qb_loops" = "true" ]         && cmd+=( --no-qb-loops )
    [ -n "$alpha" ]                      && cmd+=( --alpha "${alpha}" )
    [ "$no_outlier_rejection" = "true" ] && cmd+=( --no-outlier-rejection )
    [ -n "$purifibre_first" ]            && cmd+=( --purifibre-first "${purifibre_first}" )
    [ -n "$purifibre" ]                  && cmd+=( --purifibre "${purifibre}" )
    cmd+=( --loop-qb-thr "${loop_qb_thr}" )
    cmd+=( --nthreads "${nthreads}" )
    cmd+=( --force )
    cmd+=( "${tractogram}" "${output_track}" "${min_length}" "${max_length}" "${angle}" /tmp 0 )
    [ -n "$structural" ] && cmd+=( "${structural}" )

    echo "[INFO] Running filter_spurious_streamlines.sh inside container..."
    printf '  %q' "${cmd[@]}"
    echo

    singularity exec -e \
        docker://gamorosino/tract_align:v1.1 \
        micromamba run -n tract_align "${cmd[@]}"
}

# ============================================================================
# Print common parameters
# ============================================================================

echo "[INFO] min_length     : $min_length"
echo "[INFO] max_length     : $max_length"
echo "[INFO] angle          : $angle"
echo "[INFO] loop_qb_thr    : $loop_qb_thr"
echo "[INFO] nthreads       : $nthreads"

# ============================================================================
# Run single tract or loop over folder
# ============================================================================

if [[ "$resolved_tcks_dir" = "null" ]]; then
    # --- single-track mode ---
    ext="${track##*.}"
    outputdir="$([[ "$output_dir" != "null" && -n "$output_dir" ]] && echo "$output_dir" || echo "${SCRIPT_DIR}/track")"
    mkdir -p "${outputdir}"
    output_track="${outputdir}/track.${ext}"

    echo "[INFO] Input track    : $track"
    echo "[INFO] Output         : $output_track"

    run_one_tract "$track" "$output_track"
    echo "[INFO] Done. Output saved to: ${output_track}"

else
    # --- tcks directory mode ---
    outputdir="$([[ "$output_dir" != "null" && -n "$output_dir" ]] && echo "$output_dir" || echo "${SCRIPT_DIR}/clean_tracts")"
    mkdir -p "${outputdir}"

    shopt -s nullglob
    tck_files=("$resolved_tcks_dir"/*.tck)
    shopt -u nullglob

    echo "[INFO] Input tcks dir : $resolved_tcks_dir"
    echo "[INFO] Output dir     : $outputdir"
    echo "[INFO] Found ${#tck_files[@]} .tck files"

    for tract_file in "${tck_files[@]}"; do
        output_track="${outputdir}/$(basename "${tract_file}")"
        echo ""
        echo "[INFO] Processing: $(basename "${tract_file}")"
        run_one_tract "$tract_file" "$output_track"
        echo "[INFO] Done: ${output_track}"
    done

    echo ""
    echo "[INFO] All done. Cleaned tractograms saved to: ${outputdir}"
fi
